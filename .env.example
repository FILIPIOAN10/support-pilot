# Copy to .env (never commit .env). Every value has a safe default for local development.
# The dev-* keys below are public placeholders for local development only: set real keys anywhere else.

GATEWAY_API_KEY=dev-gateway-key     # the shop's gateway: proves that X-Customer-Id was authenticated
ADMIN_API_KEY=dev-admin-key         # the human support agents who approve refunds

MONGO_URL=mongodb://localhost:27018
REDIS_URL=redis://localhost:6380/0
RATE_LIMIT_PER_MINUTE=20

ORDERS_BASE_URL=http://localhost:9000
ORDERS_API_KEY=dev-orders-key
DOCUASK_BASE_URL=http://localhost:8000
DOCUASK_API_KEY=dev-key

# fake = scripted offline model (tests, CI, first demo). openai | azure = a real model.
LLM_PROVIDER=fake
# OPENAI_API_KEY=sk-...
# CHAT_MODEL=gpt-4.1-mini          # a model that supports tool calling and that your account can use
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=...
# AZURE_CHAT_DEPLOYMENT=...

# Agent guardrails: rounds the model may take in one run, and tool calls it may make
MAX_MODEL_CALLS=6
MAX_TOOL_CALLS=5
